# ---------------------------------------------------------------------------
# Local development
#
# The /api/account/* routes need a Privy access token, signed Telegram init data
# and a Supabase profile row, none of which can be produced outside Telegram.
# Setting DEV_ACCOUNT_WALLET short-circuits that and serves account routes for
# the given address, so `pnpm dev` can exercise the whole app.
#
# Local-only by construction: it is ignored whenever NODE_ENV is "production",
# which includes every Vercel deployment, Preview as well as Production. Do not
# set these in Vercel — they would do nothing there anyway.
# ---------------------------------------------------------------------------
DEV_ACCOUNT_WALLET=
DEV_ACCOUNT_PRIVY_USER_ID=
DEV_ACCOUNT_TELEGRAM_USER_ID=

# Point the app at Hyperliquid testnet while developing.
# VITE_HYPERLIQUID_TESTNET=true

# Privy
VITE_PRIVY_APP_ID=your_privy_app_id
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# Hyperliquid
VITE_HYPERLIQUID_TESTNET=false

# Fast market/account read cache
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# Vercel Marketplace may provision these legacy KV aliases instead.
KV_REST_API_URL=your_vercel_kv_rest_url
KV_REST_API_TOKEN=your_vercel_kv_rest_token
EDGE_CONFIG=your_vercel_edge_config_connection_string
MARKET_POLICY_JSON=
MARKET_TELEGRAM_BOT_TOKEN=
MARKET_PREVIEW_BYPASS_SECRET=
PROFILE_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Builder Code
VITE_BUILDER_ADDRESS=0xYOUR_BUILDER_ADDRESS
VITE_BUILDER_FEE=50

# Ask Privy to pay the gas on the Arbitrum leg of a deposit ("true" to enable).
# Requires TEE execution enabled for the app AND Arbitrum selected in the
# dashboard under Gas sponsorship -> App pays. Without both, Privy does not
# document what a sponsored request does, so leave this unset until verified.
VITE_SPONSOR_DEPOSIT_GAS=false

# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CRON_SECRET=your_vercel_cron_secret

# Telegram notifications worker
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
NOTIFICATION_POLL_INTERVAL_MS=15000
NOTIFICATION_DELIVERY_BATCH_SIZE=50
NOTIFICATION_RUN_ONCE=false

# Channel the "join the channel" quest is verified against, as @handle or a
# numeric id. The bot above must be an administrator of it, or Telegram will
# not answer getChatMember. Leave unset and the quest is not offered at all
# rather than shown to users who could never complete it.
TELEGRAM_CHANNEL_ID=

# On-Ramp
VITE_ONRAMP_URL=your_onramp_redirect_url
ONRAMP_BASE_URL=http://your_vps_static_ip:8080
ONRAMP_PROXY_TOKEN=shared_secret_between_vercel_and_proxy
ONRAMP_SERVICE_ID=your_onramp_service_id
ONRAMP_SYMBOL=RUB-USDT
ONRAMP_PROVIDER_SYMBOL=RUB-USDT
ONRAMP_NETWORK=TRC20
ONRAMP_RETURN_URL=https://your-mini-app-domain/account/deposit

# Platform orchestration
PLATFORM_ADMIN_KEY=shared_secret_for_internal_platform_routes
PLATFORM_WEBHOOK_SECRET=shared_secret_for_platform_webhook_signatures
# Signs the short-lived quote tokens /api/transactions requires. Falls back to
# PLATFORM_WEBHOOK_SECRET, but should be its own key.
PLATFORM_QUOTE_SECRET=shared_secret_for_signing_quotes
# Comma-separated ISO country codes. High risk adds a review-tier risk flag;
# prohibited rejects the corridor outright with no review path.
PLATFORM_HIGH_RISK_COUNTRIES=
PLATFORM_PROHIBITED_COUNTRIES=

# On-Ramp proxy only, not needed in Vercel once provider calls go through the VPS.
ONRAMP_PROVIDER_BASE_URL=https://moonlander-dev.tsunami.cash/api/v2
ONRAMP_CLIENT_ID=your_provider_client_id
ONRAMP_SECRET=your_provider_secret

# Support
VITE_SUPPORT_FAQ_URL=
VITE_SUPPORT_SURVEY_URL=
VITE_SUPPORT_TWITTER_URL=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_BUG_URL=

# Legal
VITE_LEGAL_TERMS_URL=
VITE_LEGAL_PRIVACY_URL=
