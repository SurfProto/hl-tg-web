{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/tg-mini-app/dist",
  "framework": "vite",
  "installCommand": "pnpm install",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "node_modules/.pnpm/@nktkas+hyperliquid@*/node_modules/@nktkas/hyperliquid/**"
    }
  },
  "crons": [
    { "path": "/api/notifications/worker", "schedule": "* * * * *" },
    { "path": "/api/market/stats", "schedule": "* * * * *" },
    { "path": "/api/rewards/sync-fills", "schedule": "*/10 * * * *" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
